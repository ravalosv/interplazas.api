          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Servicio Editado\"\n}"
        },
        "url": {
          "raw": "{{interapi_url}}/tipo_servicio/{{tipoServicioId}}",
          "host": ["{{interapi_url}}"],
          "path": ["tipo_servicio", "{{tipoServicioId}}"]
        }
      }
    },
    {
      "name": "TipoServicio - Eliminar",
      "request": {
        "method": "DELETE",
        "header": [
