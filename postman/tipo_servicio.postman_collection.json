          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Nuevo Servicio\"\n}"
        },
        "url": {
          "raw": "{{interapi_url}}/tipo_servicio",
          "host": ["{{interapi_url}}"],
          "path": ["tipo_servicio"]
        }
      }
    },
    {
      "name": "TipoServicio - Actualizar",
      "request": {
        "method": "PUT",
        "header": [
