{
  "info": {
    "name": "Inter API - Tipo Servicio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TipoServicio - Lista",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{interapi_url}}/tipo_servicio",
          "host": ["{{interapi_url}}"],
          "path": ["tipo_servicio"]
        }
      }
    },
    {
      "name": "TipoServicio - Obtener por ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{interapi_url}}/tipo_servicio/{{tipoServicioId}}",
          "host": ["{{interapi_url}}"],
          "path": ["tipo_servicio", "{{tipoServicioId}}"]
        }
      }
    },
    {
